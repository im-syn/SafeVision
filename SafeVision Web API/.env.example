# Server. Keep 127.0.0.1 for local-only use; use 0.0.0.0 behind a firewall/reverse proxy.
SAFEVISION_API_HOST=127.0.0.1
SAFEVISION_API_PORT=5000
SAFEVISION_API_DEBUG=false
SAFEVISION_API_MAX_UPLOAD_MB=50
SAFEVISION_API_MAX_URL_MB=50
SAFEVISION_API_URL_TIMEOUT=20

# Paths may be absolute or relative to the SafeVision project root.
SAFEVISION_RULE_FILE=BlurException.rule
SAFEVISION_NSFW_MODEL=Models/best.onnx
SAFEVISION_AGE_GENDER_MODEL=Models/onnx-communityage-gender-prediction-ONNX.onnx
SAFEVISION_API_UPLOAD_FOLDER=SafeVision Web API/runtime/uploads
SAFEVISION_API_OUTPUT_FOLDER=SafeVision Web API/runtime/outputs
SAFEVISION_API_TEMP_FOLDER=SafeVision Web API/runtime/temp

# Checks and policy defaults. Every request may still choose a subset of checks.
SAFEVISION_DETECTORS=nude,age,gender
SAFEVISION_UNDERAGE_AGE=18
SAFEVISION_AGE_REVIEW_MARGIN=3
SAFEVISION_BLOCK_IF_NSFW_AND_CHILD=true
SAFEVISION_PROTECTION_FORCES_FULL_COVER=true

# Leave blank to use the selected .rule file. Valid modes: blur, gray, black, color.
SAFEVISION_FULL_COVER_MODE=
SAFEVISION_FULL_COVER_COLOR=
SAFEVISION_FULL_COVER_TEXT_COLOR=
SAFEVISION_FULL_COVER_SHOW_TEXT=
